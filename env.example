# 設定ファイルの雛形（キー名のみ）。VPS 上で同じフォルダに .env としてコピーし、値を書く。
# 値はこのファイルにもターミナルにも書かない。
APP_BASE_URL=https://mosaic.tamago-ai-world.com
SESSION_SECRET=

# 認証: passcode（合言葉＋端末 Cookie・既定）| line（LINE ログイン。LINE_LOGIN_* が空なら passcode で動く）
AUTH_MODE=passcode
APP_PASSCODE=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
# LINE 通知（Messaging API）。空なら通知は送らずログに notify(skip) を出す
LINE_MSG_CHANNEL_ACCESS_TOKEN=
LINE_MSG_CHANNEL_SECRET=
# LINE_MOCK=1 は開発用（userId を手入力するログイン画面）。本番には書かない

# 運営通知（Discord Webhook・たまご管理サーバー）。空なら送らずログに discord(skip) を出す
DISCORD_WEBHOOK_ALERTS=
DISCORD_WEBHOOK_REPORTS=
DISCORD_WEBHOOK_USAGE=

# 保存期間: 元動画・元画像・解析データ（時間・既定 24）／完成品（日・既定 30）
# 旧名 RETENTION_HOURS も読む（SOURCE_RETENTION_HOURS が優先）
SOURCE_RETENTION_HOURS=24
OUTPUT_RETENTION_DAYS=30
# 動画1本の長さの上限の上限（秒・既定 180）。実際の上限はプランの「1本の長さ」との小さい方
MAX_VIDEO_SEC=
